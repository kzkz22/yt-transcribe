# /etc/yt-transcribe/api.env  (chmod 600, owner yttranscribe)
DATA_DIR=/var/lib/yt-transcribe
# A GPU-worker llama-swapon keresztül (ugyanabban az LXC-ben fut a llama-swap)
WORKER_URL=http://127.0.0.1:8080/upstream/yt-transcribe-gpu
# Felhős mód (üresen hagyva ki van kapcsolva)
ASSEMBLYAI_API_KEY=
#ASSEMBLYAI_BASE_URL=https://api.eu.assemblyai.com
CLOUD_MONTHLY_HOURS=20
# Ha a YouTube bejelentkezést kér:
#YTDLP_COOKIES=/etc/yt-transcribe/cookies.txt
