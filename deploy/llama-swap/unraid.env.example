# /etc/llama-swap/unraid.env  (chmod 600, owner llamaswap)
UNRAID_URL=http://192.168.1.20
UNRAID_API_KEY=ide-jon-az-unraid-api-kulcs
# GPU-t használó konténerek neve, ahogy az Unraid Docker fülén látszik.
# Minden új GPU-s konténert ide is fel kell venni.
GPU_CONTAINERS="llama.cpp yt-transcribe-gpu"
POLL_S=5
# Ha az Unraid felülete önaláírt HTTPS-tanúsítványt használ:
#CURL_OPTS="-k"
